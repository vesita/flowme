# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
uv.toml
.env

# 模型权重与训练产物（体积大、可复现，不入 git）
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# 训练中间产物
out/
*.log
# ★ 类别规则（用户 2026-10-12 定）：**日志与原始产物一律不入库**；进仓库的只有**分析结论**
#   （`REPORT.md` / `PREREG.md` / `PROJECT_STATE.md` / `methodology/` / `DEVLOG.md`）。
#   不按尺寸、不按扩展名挑 —— 一个"看起来是结论的小 json"会随手长大，也会诱导别人拿原始产物
#   当结论提交；结论该由人写进 REPORT，日志替代不了它。
#   依据：`methodology/RULES.md` R32 与 `AGENTS.md §2`（同一个家，不许两处说法不一致）。
logs/
# 权重与 ckpt 继续忽略（logs/*.pt 合计 1.2G）

# 其他常见模型权重格式
*.bin
*.gguf
*.msgpack
*.h5
*.pb
*.tflite

# 发布暂存目录（权重不进 git）
release/

# 实验派生缓存：数据集转储，可由脚本重建（体积大）
experiments/**/person_val_seed*.json
experiments/**/cache/
*.pkl

# GPU 崩溃转储（ROCm 并发争用时会掉在仓库根，单个 ~160MB）
gpucore.*

# 实验产物（数据集 / 特征缓存 / 预测结果）：体积大且可由脚本再生，不入库。
# 实测依据：83 个提交的上行 59.5 MB 里，experiments/ 占 97.6%（Top30 blob 全在此）。
# 用「排除文件而非目录」的写法，这样下面的 ! 例外才生效。
experiments/**/data/*
experiments/**/features/*
experiments/**/results/*
!experiments/**/results/*.md
!experiments/**/results/*summary*.json
!experiments/**/results/gates.json
!experiments/**/results/ecriteria.json
# 注：REPORT.md / PREREG.md / 实验代码都在实验根目录，不受影响；结论要写在那里。

# 各实验目录下的 logs/ 同理：**一律不入库**（自检 / 完成标记都由 `run_all.sh` 当场生成）。
# 依据：上面的 `logs/` 只匹配仓库根，`experiments/*/logs/` 要单独写；不放开任何例外，
# 因为"小完成标记"和"原始日志"在同一个目录里，按扩展名挑必然越挑越多。
experiments/*/logs/
