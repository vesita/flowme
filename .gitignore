# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
uv.toml
.env

# 模型权重与训练产物（体积大、可复现，不入 git）
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# 训练中间产物
out/
logs/*
*.log
# 过程日志不入库（可重建、体积大：实测 .log 合计 2.6M）。因此：关键数字必须复述进
# REPORT / results.json / 提交信息 —— 日志没有版本控制，随时会丢。
#
# 但【结论性产物】必须入库（它们是"结果"而不是"过程"）：逐点原始数字 / 账本报告 / 摘要。
# 体积实测：*.jsonl 132K + *.txt 72K ⇒ 完全可追踪。
# 依据：FRESH_VIEW 审计发现"判决只存在于提交信息里"、且提交信息引用的 logs/ 行号无法核实。
!logs/*.jsonl
!logs/*.json
!logs/*.txt
!logs/*_report.txt
!logs/*_ledger*.json
!logs/*_summary*.json
# 权重与 ckpt 继续忽略（logs/*.pt 合计 1.2G）

# 其他常见模型权重格式
*.bin
*.gguf
*.msgpack
*.h5
*.pb
*.tflite

# 发布暂存目录（权重不进 git）
release/

# 实验派生缓存：数据集转储，可由脚本重建（体积大）
experiments/**/person_val_seed*.json
experiments/**/cache/
*.pkl

# GPU 崩溃转储（ROCm 并发争用时会掉在仓库根，单个 ~160MB）
gpucore.*

# 实验产物（数据集 / 特征缓存 / 预测结果）：体积大且可由脚本再生，不入库。
# 实测依据：83 个提交的上行 59.5 MB 里，experiments/ 占 97.6%（Top30 blob 全在此）。
# 用「排除文件而非目录」的写法，这样下面的 ! 例外才生效。
experiments/**/data/*
experiments/**/features/*
experiments/**/results/*
!experiments/**/results/*.md
!experiments/**/results/*summary*.json
!experiments/**/results/gates.json
!experiments/**/results/ecriteria.json
# 注：REPORT.md / PREREG.md / 实验代码都在实验根目录，不受影响；结论要写在那里。
